# ── Your LLM provider — plug and play ───────────────────────────────────────
# The dev proxy reads these server-side; your key never reaches the browser.

# 1) API key for your provider.
LLM_API_KEY=your-key-here

# 2) Protocol your endpoint speaks: "anthropic" or "openai"
VITE_LLM_PROTOCOL=openai

# 3) Base URL for the endpoint:
#    Anthropic       : https://api.anthropic.com        ->  VITE_LLM_PROTOCOL=anthropic
#    OpenRouter      : https://openrouter.ai/api/v1      ->  VITE_LLM_PROTOCOL=openai
#    OpenAI          : https://api.openai.com/v1         ->  VITE_LLM_PROTOCOL=openai
#    Groq            : https://api.groq.com/openai/v1    ->  VITE_LLM_PROTOCOL=openai
#    Together        : https://api.together.xyz/v1       ->  VITE_LLM_PROTOCOL=openai
#    Ollama (local)  : http://localhost:11434/v1         ->  VITE_LLM_PROTOCOL=openai
LLM_BASE_URL=https://openrouter.ai/api/v1

# 4) Model id your endpoint supports (see GET /v1/models).
VITE_MODEL=anthropic/claude-3.5-sonnet

# Max output tokens per generated document (optional; default 16000).
# Lower to 8192 or 4096 if your model has a smaller output cap.
VITE_MAX_TOKENS=16000
